# Copy this file to ".env" (same folder) and fill in what you want to use.
# Every setting is optional: with no key at all, the app runs in free rules-only mode.
# Never commit .env or share your keys.

# ---- AI providers (tried in this order: gemini, groq, openai-compatible, anthropic) ----

# Google Gemini: FREE tier, no card needed. Get a key at https://aistudio.google.com/apikey
# (Both key formats work: the older "AIza..." and the newer "AQ....")
GEMINI_API_KEY=
# Cheapest model first; a stronger one is used only if the first answer is incomplete.
# INPRO_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Groq: FREE tier backup (used when Gemini is rate-limited). Key at https://console.groq.com/keys
GROQ_API_KEY=
# INPRO_GROQ_MODELS=openai/gpt-oss-120b

# Any OpenAI-compatible service. Examples:
#   OpenRouter free models:  INPRO_OPENAI_BASE_URL=https://openrouter.ai/api/v1   INPRO_OPENAI_MODEL=<a model ending in :free>
#   Local Ollama (free, private, nothing leaves your laptop):
#                            INPRO_OPENAI_BASE_URL=http://localhost:11434/v1     INPRO_OPENAI_MODEL=qwen3:8b
# INPRO_OPENAI_BASE_URL=
# INPRO_OPENAI_MODEL=
# INPRO_OPENAI_API_KEY=

# Claude (paid, no free tier; Haiku is the cheapest). Key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# INPRO_ANTHROPIC_MODELS=claude-haiku-4-5

# ---- How AI is used ----
# auto (default) = rules first, AI only when needed, if a key is set; rules = never use AI; ai = AI on every invoice
# INPRO_EXTRACTOR=auto
# Hard limits so there is never a surprise bill:
# INPRO_LLM_DAILY_LIMIT=300
# INPRO_LLM_MONTHLY_BUDGET_USD=1.00
# If billing is turned on for your Gemini key (paid tier), set this to 1: costs are then estimated,
# the app may send requests faster, and Google does not use paid-tier data to improve its products.
# INPRO_GEMINI_PAID=0

# ---- Sign-in and security ----
# Sign-in is ON by default. Demo mode creates three demo accounts on first start and lists them
# on the sign-in page (good for showing the prototype). For real use set INPRO_DEMO_MODE=0 and
# give the first admin account below; that admin then creates everyone else on the Users page.
# INPRO_DEMO_MODE=1
# INPRO_DEMO_PASSWORD=InPro-Demo-2026
# INPRO_ADMIN_NAME=Your Name
# INPRO_ADMIN_EMAIL=you@company.com
# INPRO_ADMIN_PASSWORD=
# Sessions end after this many hours without activity:
# INPRO_SESSION_HOURS=8
# Token for integrations such as a Power Automate flow (sent as "Authorization: Bearer <token>"):
# INPRO_SERVICE_TOKEN=
# Only for local experiments: switch sign-in off completely
# INPRO_AUTH=1

# ---- Business rules ----
# INPRO_AUTO_LIMIT=50000
# INPRO_REQUIRE_PO=0

# ---- Invoices that arrive by themselves (Inbox page) ----
# Watched folder: drop PDFs, photos or saved e-mails (.eml) here and they are picked up automatically.
# INPRO_INBOX_DIR=inbox
# How often (seconds) the folder and the mailbox are checked; set INPRO_INTAKE=0 to switch intake off.
# INPRO_INTAKE_INTERVAL=20
# INPRO_INTAKE=1
# A real mailbox over IMAP (Gmail, Zoho, most company mail servers). Use an APP PASSWORD, not your
# normal password. (Outlook.com / Microsoft 365 no longer accept passwords over IMAP; they need Microsoft's
# OAuth sign-in, which is on the plan as a Microsoft Graph connection.) Gmail: turn on 2-step verification, then create one at https://myaccount.google.com/apppasswords
# Unread messages are fetched, their PDF/image attachments checked, and the messages marked as read.
# INPRO_IMAP_HOST=imap.gmail.com
# INPRO_IMAP_USER=invoices@yourcompany.com
# INPRO_IMAP_PASSWORD=
# INPRO_IMAP_FOLDER=INBOX
# INPRO_IMAP_PORT=993

# ---- Overview page: the two time assumptions behind "checking time saved" ----
# Minutes a person needs to check one invoice by hand, and to review one the copilot already read and checked.
# INPRO_MANUAL_MINUTES=7
# INPRO_REVIEW_MINUTES=2

# ---- Tesseract location (only if it is not found automatically) ----
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
